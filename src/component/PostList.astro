---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<ul>
  {posts.map((post) => (
    <li>
      <a href={`/${post.id}/`}>{post.data.title}</a>
    </li>
  ))}
</ul>

<style>
  ul {
    list-style-type: none;
    padding: 0;
  }
  a {
    text-decoration: none;
  }
</style>
